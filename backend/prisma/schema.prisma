generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  audits       Audit[]
}

model Audit {
  id               String   @id @default(uuid())
  url              String
  status           Int
  responseTimeMs   Int
  title            String?
  metaDescription  String?
  h1Count          Int
  imagesMissingAlt Int
  wordCount        Int
  score            Int
  grade            String
  createdAt        DateTime @default(now())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
